<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Foglalás
    </title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css">
</head>

<body>
    <div class="container">
        <header class="mb-3">
            <h1>Petrik Hotel szállásfoglaló oldala</h1>
            <h2>Foglalások száma: <%= foglalasok %></h2>
        </header>
        <main>
            <h2>Foglalás leadó űrlap</h2>
            <form method="post" class="mb-3">
                <label for="name" class="form-label">Név</label>
                <input type="text" class="form-control" name="name" value="<%= locals.name %>"> <br>
                <label for="email" class="form-label">Email</label>
                <input type="text" class="form-control" name="email" value="<%= locals.email %>"> <br>
                <label for="startDate" class="form-label">Mikortól szállna meg?</label>
                <input type="datetime-local" class="form-control" name="startDate" value="<%= locals.startDate %>"> <br>
                <label for="guests" class="form-label">Személyek száma</label>
                <input type="number" class="form-control" name="guests" value="<%= locals.guests %>"> <br>
                <button class="btn btn-primary" type="submit">Foglalás leadása</button>
            </form>

            <% if (locals.errors) { %>
                <div class="alert alert-danger">
                    <p class="fail"><b>Kérjük helyesen töltse ki az űrlapot!</b></p>
                    <ul>
                        <% errors.forEach(error => { %>
                            <li><%= error %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>
            
            <% if (locals.success) { %>
                <div class="alert alert-success">
                    <%= success %>
                </div>
            <% } %>
        </main>
    </div>

</body>

</html>